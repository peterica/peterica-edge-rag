# Ollama
OLLAMA_URL=http://localhost:11434

# Embedding models
# 서버·모바일 모두 e5-small-ko-v2(384d)로 통일 — P3-3 벤치마크 근거
# (확장 테스트 22 쿼리, R@3 0.955 / MRR 0.860, 영어·긴문맥·모호 세그먼트 전부 우세)
SERVER_EMBED_MODEL=dragonkue/multilingual-e5-small-ko-v2
SERVER_EMBED_BACKEND=sentence-transformers   # ollama | sentence-transformers
MOBILE_EMBED_MODEL=dragonkue/multilingual-e5-small-ko-v2
MOBILE_EMBED_BACKEND=sentence-transformers

# Data
WIKI_DIR=/Users/seodong-eok/peterica/semi-project/peterica-blog-wiki/wiki
SERVER_DB_PATH=./data/server.db
MOBILE_DB_PATH=./data/mobile.db

# Embedding dimensions
SERVER_EMBED_DIM=384
MOBILE_EMBED_DIM=384

# RAG
TOP_K=12
RAG_DISTANCE_MAX=0.65
RAG_MIN_K=3
RAG_MAX_K=3

# LLM (생성 모델)
# 기본값 gemma4:e4b-it-q4_K_M — scripts/prompt_eval.py 벤치마크 근거
# (CC=0.889, SR=0, CorrectRefuse=1.0 @ v4 프롬프트)
SERVER_LLM_MODEL=gemma4:e4b-it-q4_K_M
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60.0

# Server
HOST=0.0.0.0
PORT=8600

# Auth (빈 값이면 인증 비활성, 로컬 개발용)
# 운영에서는 예: SERVER_API_KEY=$(openssl rand -hex 32)
SERVER_API_KEY=
