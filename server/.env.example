# Ollama
OLLAMA_URL=http://localhost:11434
SERVER_EMBED_MODEL=bge-m3
MOBILE_EMBED_MODEL=embeddinggemma:300m

# Data
WIKI_DIR=/Users/seodong-eok/peterica/semi-project/peterica-blog-wiki/wiki
SERVER_DB_PATH=./data/server.db
MOBILE_DB_PATH=./data/mobile.db

# Embedding dimensions
SERVER_EMBED_DIM=1024
MOBILE_EMBED_DIM=768

# RAG
TOP_K=12
RAG_DISTANCE_MAX=0.65
RAG_MIN_K=3
RAG_MAX_K=3

# LLM (생성 모델)
# 기본값 gemma4:e4b-it-q4_K_M — scripts/prompt_eval.py 벤치마크 근거
# (CC=0.889, SR=0, CorrectRefuse=1.0 @ v4 프롬프트)
SERVER_LLM_MODEL=gemma4:e4b-it-q4_K_M
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60.0

# Server
HOST=0.0.0.0
PORT=8600

# Auth (빈 값이면 인증 비활성, 로컬 개발용)
# 운영에서는 예: SERVER_API_KEY=$(openssl rand -hex 32)
SERVER_API_KEY=
